{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sakthi-textile-media-proxy",
  "account_id": "fb04e106c31247ba90f537dc0d5f9b62",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sakthi-textile-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
