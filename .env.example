# Copy ALL lines below into Vercel → Project → Settings → Environment Variables
# (Production + Preview). Values: copy from your local .env.local — never commit .env.local.

# Supabase (Postgres / Auth / GraphQL only — not Storage)
NEXT_PUBLIC_SUPABASE_PROJECT_REF=qhtwwyqlsnckorndmhmt
NEXT_PUBLIC_SUPABASE_URL=https://qhtwwyqlsnckorndmhmt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_SERVICE_ROLE=

# Database — Supabase pooler (session :5432 in dashboard is OK; app rewrites to transaction :6543).
# Or paste transaction pooler URI directly. Then run:
#   npm run db:bootstrap-new
#   node scripts/verify-db-url.mjs
DATABASE_URL=

# Cloudflare R2 (Sakthi Textile account stsareess@gmail.com)
NEXT_PUBLIC_S3_BUCKET=sakthi-textile-media
NEXT_PUBLIC_S3_REGION=auto
S3_ENDPOINT=https://fb04e106c31247ba90f537dc0d5f9b62.r2.cloudflarestorage.com
NEXT_PUBLIC_CDN_URL=https://pub-351c586a832c41d6816471c888ca13c4.r2.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Worker proxy (browser/Vercel → Worker → R2)
R2_MEDIA_PROXY_URL=https://sakthi-textile-media-proxy.stsareess.workers.dev
R2_MEDIA_PROXY_SECRET=

# Image delivery — leave legacy until /cdn Images binding is validated
# NEXT_PUBLIC_IMAGE_DELIVERY_MODE=cloudflare
# NEXT_PUBLIC_MEDIA_CDN_ORIGIN=https://sakthi-textile-media-proxy.stsareess.workers.dev

# Stripe (placeholders until Razorpay/Stripe setup)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECERT_KEY=

# Deployment — production custom domain
NEXT_PUBLIC_SITE_URL=https://www.sakthitextile.com

# Guest order access tokens (required in production — do not rely on fallbacks)
ORDER_ACCESS_SECRET=

# Auth rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — only if you add external cron (Vercel Pro or cron-job.org).
CRON_SECRET=

# Local/docker builds only — omit in Vercel Production once all vars above are set
SKIP_ENV_VALIDATION=true
